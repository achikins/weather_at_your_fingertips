# =========================================================
#  Weather At Your Fingertips - environment variables
#  Copy this file to .env and edit as needed
# =========================================================

# Default: use the local Docker Postgres (no .env needed at all)

# To use the shared Fly.io Postgres with real BOM data:
# 1. Install flyctl: https://fly.io/docs/hands-on/install-flyctl/
# 2. Run 'fly auth login'
# 3. Get added to the WAYF Fly org (one-time)
# 4. In a separate terminal, run and leave running:
#       fly proxy 5433:5432 -a wayf-db
# 5. Uncomment the line below (get the password from whatsapp):
#
# DATABASE_URL=postgresql://postgres:<password>@host.docker.internal:5433/weather_at_your_fingertips_db
